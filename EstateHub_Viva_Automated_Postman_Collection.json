{
  "info": {
    "name": "EstateHub Viva Demo (Ultimate Automated)",
    "description": "Flawless Postman collection for the EstateHub Viva presentation. Includes token extraction and global authorization.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login User & Extract Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let response = pm.response.json();",
                  "if (response.token) {",
                  "    pm.collectionVariables.set(\"jwt_token\", response.token);",
                  "    console.log(\"Token automatically saved!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"member1@gmail.com\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/auth/login",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Register User",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Jane Doe\",\n    \"email\": \"jane.doe@example.com\",\n    \"password\": \"securepass123\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/auth/register",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/auth/profile",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "auth",
                "profile"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Properties",
      "item": [
        {
          "name": "Get All Properties",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/properties",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "properties"
              ]
            }
          }
        },
        {
          "name": "Create Property",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Stunning Oceanview Villa\",\n    \"description\": \"A beautiful villa with an ocean view in Malibu.\",\n    \"price\": 1250000.00,\n    \"location\": \"Malibu, CA\",\n    \"propertyType\": \"VILLA\",\n    \"bedrooms\": 5,\n    \"bathrooms\": 4,\n    \"area\": 4500.5,\n    \"status\": \"AVAILABLE\",\n    \"imageUrl\": \"https://example.com/villa.jpg\",\n    \"agentId\": \"agent-101\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/properties",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "v1",
                "properties"
              ]
            }
          }
        }
      ]
    },
    {
